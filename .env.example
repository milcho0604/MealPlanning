# =====================================================================
# MealPlan 환경 변수 예시 파일
# 실제 값을 채워서 .env 로 복사하여 사용
# .env 파일은 절대 Git에 커밋하지 말 것
# =====================================================================

# ── Supabase ──────────────────────────────────────────────────────────
# Supabase 프로젝트 URL (Settings > API > Project URL)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon key (공개 키, 클라이언트에서 사용 가능)
SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (비공개 키, 서버에서만 사용)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Database ──────────────────────────────────────────────────────────
# Prisma가 사용하는 PostgreSQL 연결 URL
# Supabase > Settings > Database > Connection String (URI)
DATABASE_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# ── JWT ───────────────────────────────────────────────────────────────
# JWT 서명에 사용할 시크릿 키 (최소 32자 이상의 랜덤 문자열 권장)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# ── API Server ────────────────────────────────────────────────────────
# NestJS 서버 포트
API_PORT=3000

# 클라이언트에서 호출하는 API 기본 URL
API_BASE_URL=http://localhost:3000

# ── Mobile App ────────────────────────────────────────────────────────
# Expo 앱에서 참조하는 API URL (EXPO_PUBLIC_ 접두사 필수)
EXPO_PUBLIC_API_URL=http://localhost:3000
