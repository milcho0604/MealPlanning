{
  "name": "mealplan",
  "version": "0.0.1",
  "private": true,
  "description": "MealPlan 모노레포 루트 - 식단 계획 앱",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
